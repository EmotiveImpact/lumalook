# Postgres connection string (Neon in production)
DATABASE_URL=
# Long random string that signs admin logins
PAYLOAD_SECRET=
# The site's own address, e.g. https://lumalook.app
NEXT_PUBLIC_SERVER_URL=
# Vercel Blob token for image uploads (production)
BLOB_READ_WRITE_TOKEN=
# Forms (same as the old site)
RESEND_API_KEY=
WAITLIST_REPLY_TO=
RESEND_WAITLIST_SEGMENT_ID=
FOUNDERS_NOTIFY_TO=
PARTNERS_NOTIFY_TO=
# One-off: set to true for the first deploy to load the starter content and admin, then remove
SEED_ON_BUILD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Leave unset. Only set to true if you ever need the "create first user" screen again
ADMIN_SIGNUP_OPEN=
